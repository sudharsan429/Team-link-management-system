# Copy this file to .env and edit the values. Do not commit .env to Git.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Local PostgreSQL example; create database tlms first.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tlms
DB_SSLMODE=prefer
ADMIN_USERNAME=abisiva
ADMIN_PASSWORD=change-this-admin-password
FLASK_DEBUG=true
